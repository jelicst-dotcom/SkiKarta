{
  "name": "SkiKarta",
  "short_name": "SkiKarta",
  "description": "Izvještaj i poster skijaškog dana iz GPX-a, bez poslužitelja",
  "start_url": "index.html",
  "scope": "./",
  "display": "standalone",
  "background_color": "#14202b",
  "theme_color": "#14202b",
  "icons": [
    {
      "src": "ikona-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "ikona-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "share_target": {
    "action": "podijeli",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "gpx",
          "accept": [
            "application/gpx+xml",
            ".gpx",
            "application/xml",
            "text/xml",
            "application/octet-stream"
          ]
        }
      ]
    }
  }
}